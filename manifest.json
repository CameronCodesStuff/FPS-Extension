{
  "manifest_version": 3,
  "name": "FPS Overlay",
  "version": "1.0",
  "description": "Shows a live FPS counter on every tab",
  "permissions": ["scripting", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["fps.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FPS Overlay"
  }
}
